# Shared encoder assets. Query and reference fingerprints must match.
DREAMS_OFFICIAL_SLIM_CKPT=D:/DreaMS/data/e1/official_embedding_slim.pt
DREAMS_ARCHITECTURE_CKPT=D:/DreaMS/dreams/models/pretrained/ssl_model_server.pt
DREAMS_E4_CKPT=D:/DreaMS/models/showspace/e4a/final_shared_encoder.pt
DREAMS_E8_CKPT=D:/DreaMS/models/showspace/e8/final_shared_encoder.pt

# Reference library plus one full model-aligned index per enabled encoder.
DREAMS_MOLECULE_DB=D:/DreaMS/data/models/MassSpecGym_MurckoHist_split.hdf5
SHOWSPACE_REFERENCE_LABEL=PRODUCTION_MODEL_ALIGNED_REFERENCE
DREAMS_OFFICIAL_EMBEDDING_INDEX=D:/DreaMS/models/showspace/index/official.npy
DREAMS_OFFICIAL_EMBEDDING_INDEX_MANIFEST=D:/DreaMS/models/showspace/index/official.json
DREAMS_E4_EMBEDDING_INDEX=D:/DreaMS/models/showspace/index/e4a.npy
DREAMS_E4_EMBEDDING_INDEX_MANIFEST=D:/DreaMS/models/showspace/index/e4a.json
DREAMS_E8_EMBEDDING_INDEX=D:/DreaMS/models/showspace/index/e8.npy
DREAMS_E8_EMBEDDING_INDEX_MANIFEST=D:/DreaMS/models/showspace/index/e8.json

# Optional phenotype-blind BioAware evidence. Candidate and seed IDs are IK14.
BIOAWARE_RHEA_PARTICIPANTS=D:/DreaMS/data/reference/bioaware_rhea/rhea_participants.csv.gz

# Public deployment should keep Gradio on loopback and expose it through a
# named reverse tunnel. Do not use GRADIO_SHARE as a production endpoint.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
GRADIO_FRONTEND_CHECK=false
ALLOW_DEMO=false

# Local compute / public panel. Keep the origin on loopback. A named Cloudflare
# Tunnel maps your domain to this port; no Hugging Face hosting is involved.
SHOWSPACE_PUBLIC_MODE=false
SHOWSPACE_ALLOW_ANONYMOUS=false
SHOWSPACE_USERNAME=
SHOWSPACE_PASSWORD=
SHOWSPACE_MAX_FILE_SIZE=200mb
SHOWSPACE_PYTHON=D:/DreaMS/dreams-chemaware/.venv_showspace/Scripts/python.exe

# Preferred: put the remotely-managed tunnel token in this ignored file.
CLOUDFLARE_TUNNEL_TOKEN_FILE=D:/DreaMS/dreams-chemaware/showspace/secrets/cloudflare-tunnel-token.txt
CLOUDFLARED_EXE=cloudflared.exe
