#!/bin/bash
#SBATCH --job-name=chem_bpmt
#SBATCH --partition=gpu
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --time=18:00:00
#SBATCH --output=data/validation/chem_bpmt_%j.out
#SBATCH --error=data/validation/chem_bpmt_%j.err

set -euo pipefail
cd /data02/run01/scv7tsl/DreaMS
source /data02/home/scv7tsl/run/miniconda3/etc/profile.d/conda.sh
conda activate dreams
export PYTHONPATH="$PWD:$PWD/tasks:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"

RUN_ROOT="data/validation/chemaware_boundary_pmt_phase_a/run_${SLURM_JOB_ID}"
ARMS_ROOT="$RUN_ROOT/arms"
SUMMARY="$RUN_ROOT/summary/report.json"
[[ ! -e "$RUN_ROOT" ]] || { echo "Output collision: $RUN_ROOT" >&2; exit 3; }

# Resolve the newest admitted manifest generated by the integrated discovery
# job.  No job id, result value, or memory setting is manually injected.
BPMT_DIR=$(python -c 'import json,pathlib; p=pathlib.Path("data/validation/chemaware_high_specificity_action_discovery"); x=[q.parent for q in p.glob("run_*/bpmt_transfer_manifest/report.json") if json.loads(q.read_text()).get("training_authorized") is True]; assert x,"no admitted B-PMT manifest"; print(max(x,key=lambda q:q.stat().st_mtime))')
test -f "$BPMT_DIR/report.json"
test -f "$BPMT_DIR/transfer_manifest.npz"

python -m py_compile \
  tasks/chemaware_boundary_pmt_core.py \
  tasks/train_chemaware_full_candidate_alignment.py \
  tasks/summarize_chemaware_boundary_pmt.py \
  tasks/test_chemaware_boundary_pmt_core.py \
  tasks/test_build_chemaware_boundary_pmt_manifest.py \
  tasks/test_chemaware_boundary_pmt_training_contract.py
python tasks/test_chemaware_boundary_pmt_core.py
python tasks/test_build_chemaware_boundary_pmt_manifest.py
python tasks/test_chemaware_full_candidate_alignment.py
python tasks/test_chemaware_boundary_pmt_training_contract.py

COMMON=(
  --manifest data/validation/chemaware_corrected_candidate_manifest_v1/manifest.npz
  --token-dir data/validation/chemaware_corrected_manifest_tokens_v1
  --molecule-dir data/validation/absent --arm spectrum_only
  --bpmt-manifest-dir "$BPMT_DIR"
  --folds 5 --fold-seed 20260935 --inner-fold 3 --outer-fold 4
  --seed 20260907 --epochs 8 --max-steps 500 --warmup-steps 50
  --eval-every-steps 100 --batch-queries 64 --references-per-molecule 2
  --hidden-dim 256 --dropout 0.2 --learning-rate 3e-5 --weight-decay 1e-4
  --temperature 0.07 --lambda-spectrum 1.0 --lambda-inbatch-spectrum 0.25
  --lambda-margin-floor 2.0 --margin-floor-slack 0.005
  --lambda-preserve 20.0 --grad-clip 5.0
  --max-train-identities 2048 --error-identity-fraction 0.5
  --clean-safety-selection random --training-mass formula_identity
  --max-eval-identities 0 --eval-batch-size 2048 --bootstrap-draws 10000
  --lambda-bpmt 1.0 --bpmt-batch-actions 8 --bpmt-temperature 0.05
  --device cuda --torch-threads 8
)

# Full input and fold validation before any optimizer step.
python -u tasks/train_chemaware_full_candidate_alignment.py \
  --output "$RUN_ROOT/preflight" --bpmt-arm clean_duplicate \
  "${COMMON[@]}" --preflight-only

for ARM in clean_duplicate matched_formula_deranged alpha025 alpha050; do
  python -u tasks/train_chemaware_full_candidate_alignment.py \
    --output "$ARMS_ROOT/$ARM" --bpmt-arm "$ARM" "${COMMON[@]}"
  test -f "$ARMS_ROOT/$ARM/report.json"
  test -f "$ARMS_ROOT/$ARM/inner_per_query.npz"
  test -f "$ARMS_ROOT/$ARM/shared_spectrum_adapter.pt"
done

python -u tasks/summarize_chemaware_boundary_pmt.py \
  --arms-root "$ARMS_ROOT" --output "$SUMMARY" \
  --bootstrap-draws 10000 --seed 20260907
test -f "$SUMMARY"
echo "COMPLETE: ChemAware B-PMT paired shared-embedding Phase A"

