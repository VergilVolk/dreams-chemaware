#!/bin/bash
#SBATCH --gpus=1
#SBATCH --time=06:00:00
#SBATCH --output=cosmic_full_%j.out
#SBATCH --error=cosmic_full_%j.err

set -euo pipefail
export PYTHONUNBUFFERED=1
export PYTHONIOENCODING=utf-8

cd /data02/run01/scv7tsl/DreaMS
export PYTHONPATH="$PWD:${PYTHONPATH:-}"

# ============================================================================
# COSMIC Layer-1 全量闭环（检索空间，官方 retrieval embedding）
# 严格顺序：嵌入 -> 冻结 probe 重训 -> COSMIC 闭环。前一步产物是后一步输入。
#
# INPUT (must pre-exist on server):
#   1. data/models/MassSpecGym_MurckoHist_split.hdf5       # 谱图 + metadata
#   2. dreams/models/pretrained/ssl_model_server.pt         # raw SSL backbone (load_embedder)
#   3. data/e1/official_embedding_slim.pt                   # 检索 embedding 头 (load_embedder)
#   4. data/validation/double_mapping/spectrum_rule_labels.npz  # 335 位规则向量 cache
#
# GENERATED by this job:
#   data/validation/cosmic_retrieval/retrieval_embeddings.npy   # 全量 45k 检索空间嵌入
#   data/validation/cosmic_retrieval/frozen_concept_probe/      # 检索空间冻结 probe
#   data/validation/cosmic_confidence/full/                    # COSMIC 闭环报告 + 分数
#
# 严谨性门（run_cosmic_coupling.py 内 fail-fast）：
#   * 规则向量重算 == cache 逐位相等
#   * 模型前向 embedding == 检索空间缓存 (cosine >= 0.999)
# ============================================================================

echo "===== COSMIC Layer-1 full closed loop (retrieval space) ====="
echo "Started: $(date)"
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv,noheader

# 1. 全量嵌入 45k 谱（检索空间，cache-order）
python -u tasks/embed_massspecgym_retrieval.py --device cuda

# 2. 全量重训冻结 probe（检索空间，分子不相交 split + 同 seed）
python -u tasks/train_frozen_spectrum_concept_probe.py

# 3. 全量 COSMIC 闭环（5000 query，每谱每类 20 decoy，真值校准）
python -u tasks/run_cosmic_coupling.py \
    --n 5000 --n-decoys 20 --device cuda \
    --output-dir data/validation/cosmic_confidence/full

echo "===== Done: $(date) ====="
