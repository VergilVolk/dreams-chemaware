#!/bin/bash
#SBATCH --gpus=1
#SBATCH --time=04:00:00
#SBATCH --output=m3_cross_v2_%j.out
#SBATCH --error=m3_cross_v2_%j.err

set -euo pipefail
export PYTHONUNBUFFERED=1
export PYTHONIOENCODING=utf-8

cd /data02/run01/scv7tsl/DreaMS
export PYTHONPATH="$PWD:${PYTHONPATH:-}"

# ============================================================================
# DEPENDENCIES
#   data/ and dreams/models/pretrained/ are gitignored -> NOT in git.
#   The 3 INPUT files below MUST already be on the server (you sync them).
#   Code (.py, dreams/ package) is already synced by you -- no git here.
#
# INPUT (must pre-exist on server):
#   1. data/models/MassSpecGym_MurckoHist_split.hdf5      # spectra + metadata
#   2. dreams/models/pretrained/ssl_model_server.pt        # raw SSL -> model `args`
#   3. data/e1/official_embedding_slim.pt                  # official backbone+head weights
#        (derived from dreams/models/pretrained/embedding_model.ckpt via
#         `python tasks/prepare_official_embedding_checkpoint.py`)
#
# GENERATED by this job (NOT required in advance):
#   data/validation/cross_condition_m3/train_pairs.json            # M2 output
#   data/validation/cross_condition_m3/backbone_embeddings_*.npz   # frozen-emb cache
#   data/validation/cross_condition_m3/seed_{1,2,3}/best_m3.pt     # M3 output
#   data/validation/condition_invariance_benchmark/**/*.json       # benchmark
# ============================================================================

echo "===== M3 v2 (margin FP guard) cross-condition FN, 3 seeds ====="
echo "Started: $(date)"
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv,noheader

for REQUIRED in \
    data/models/MassSpecGym_MurckoHist_split.hdf5 \
    dreams/models/pretrained/ssl_model_server.pt \
    data/e1/official_embedding_slim.pt ; do
    if [[ ! -f "$REQUIRED" ]]; then
        echo "MISSING DEPENDENCY: $REQUIRED  (see DEPENDENCIES block above)" >&2
        exit 2
    fi
done
echo "All 3 input dependencies present."
echo ""

# ---- (0) M2: build the train-pair manifest (gitignored data -> regenerate here) ----
python -u tasks/step3_m2_build_cross_condition_pairs.py

# ---- (0b) official baseline once (the numbers you compare against) ----
python -u tasks/eval_condition_invariance_benchmark.py --device cuda

# ---- (1) M3 v2: 3 seeds head-only + locked benchmark each ----
#     Sequential on purpose: the 3 seeds share one frozen-backbone embedding
#     cache; serial runs avoid a concurrent-write race on that .npz.
for SEED in 1 2 3; do
    echo "===== M3 v2 seed $SEED: train ====="
    python -u tasks/step3_m3_cross_condition_train.py --seed "$SEED" --device cuda

    echo "===== M3 v2 seed $SEED: locked benchmark ====="
    python -u tasks/eval_condition_invariance_benchmark.py \
        --head-checkpoint "data/validation/cross_condition_m3/seed_${SEED}/best_m3.pt" \
        --device cuda \
        --output-dir "data/validation/condition_invariance_benchmark/seed_${SEED}"
done

echo ""
echo "===== DONE $(date) ====="
echo "Baseline (step 0b) ~ cross 0.823 / neg 0.327 / margin 0.496:"
echo "  data/validation/condition_invariance_benchmark/result_official_embedding_slim.json"
for SEED in 1 2 3; do
    echo "  seed $SEED: data/validation/condition_invariance_benchmark/seed_${SEED}/result_e1_identity_epoch20.json"
done
echo ""
echo "PASS = negative_cosine stays ~0.327 (NOT rising) AND margin >= 0.496."
echo "  (v1 seed 2 failed this: neg 0.408, margin 0.448 -- v2 must hold it flat.)"
