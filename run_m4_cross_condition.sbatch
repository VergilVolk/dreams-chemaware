#!/bin/bash
#SBATCH --gpus=2
#SBATCH --time=06:00:00
#SBATCH --output=m4_cross_%j.out
#SBATCH --error=m4_cross_%j.err

set -euo pipefail
export PYTHONUNBUFFERED=1
export PYTHONIOENCODING=utf-8

cd /data02/run01/scv7tsl/DreaMS
export PYTHONPATH="$PWD:${PYTHONPATH:-}"

# ============================================================================
# DEPENDENCIES
#   data/ and dreams/models/pretrained/ are gitignored -> NOT in git.
#   The 3 INPUT files below MUST already be on the server (you sync them).
#   Code (.py, dreams/ package) is already synced by you -- no git here.
#
# INPUT (must pre-exist on server):
#   1. data/models/MassSpecGym_MurckoHist_split.hdf5      # spectra + metadata
#   2. dreams/models/pretrained/ssl_model_server.pt        # raw SSL -> model `args`
#   3. data/e1/official_embedding_slim.pt                  # official backbone+head weights
#
# GENERATED by this job (NOT required in advance):
#   data/validation/cross_condition_m3/train_pairs.json            # M2 output (shared)
#   data/validation/cross_condition_m4_v3/seed_{1,2,3}/best_m4.pt  # M4 + loss-v3 output
#   data/validation/condition_invariance_benchmark/m4_v3_seed_{1,2,3} # benchmark
# ============================================================================

echo "===== M4 (unfreeze last-1) + loss v3 (absolute anchors) cross-condition FN, 3 seeds ====="
echo "Started: $(date)"
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv,noheader

for REQUIRED in \
    data/models/MassSpecGym_MurckoHist_split.hdf5 \
    dreams/models/pretrained/ssl_model_server.pt \
    data/e1/official_embedding_slim.pt ; do
    if [[ ! -f "$REQUIRED" ]]; then
        echo "MISSING DEPENDENCY: $REQUIRED  (see DEPENDENCIES block above)" >&2
        exit 2
    fi
done
echo "All 3 input dependencies present."
echo ""

# ---- (0) M2: build the train-pair manifest (gitignored data -> regenerate here) ----
python -u tasks/step3_m2_build_cross_condition_pairs.py

# ---- (0b) official baseline once (the numbers you compare against) ----
python -u tasks/eval_condition_invariance_benchmark.py --device cuda

# ---- (1) M4 + loss v3: 3 seeds on 2 GPUs ----
#     Loss v3 = bounded cond relu(pos_floor - pos) + absolute neg guard relu(neg - neg_ceiling)
#               + preserve. Replaces the v2 relative margin term (which let pos+neg rise together).
CUDA_VISIBLE_DEVICES=0 python -u tasks/step3_m4_cross_condition_train.py \
    --seed 1 --device cuda --unfreeze-layers 1 --backbone-lr 5e-5 \
    --pos-floor 0.88 --neg-ceiling 0.35 --neg-weight 1.0 &
PID1=$!
CUDA_VISIBLE_DEVICES=1 python -u tasks/step3_m4_cross_condition_train.py \
    --seed 2 --device cuda --unfreeze-layers 1 --backbone-lr 5e-5 \
    --pos-floor 0.88 --neg-ceiling 0.35 --neg-weight 1.0 &
PID2=$!
RC1=0; RC2=0
wait $PID1 || RC1=$?
wait $PID2 || RC2=$?
if [ "$RC1" != "0" ] || [ "$RC2" != "0" ]; then
    echo "M4-v3 seed 1/2 FAILED: rc1=$RC1 rc2=$RC2 (see .out/.err)" >&2
    exit 1
fi
CUDA_VISIBLE_DEVICES=0 python -u tasks/step3_m4_cross_condition_train.py \
    --seed 3 --device cuda --unfreeze-layers 1 --backbone-lr 5e-5 \
    --pos-floor 0.88 --neg-ceiling 0.35 --neg-weight 1.0

# ---- (2) locked benchmark for each seed (now reloads the modified backbone) ----
for SEED in 1 2 3; do
    echo "===== M4-v3 seed $SEED: locked benchmark ====="
    python -u tasks/eval_condition_invariance_benchmark.py \
        --head-checkpoint "data/validation/cross_condition_m4_v3/seed_${SEED}/best_m4.pt" \
        --device cuda \
        --output-dir "data/validation/condition_invariance_benchmark/m4_v3_seed_${SEED}"
done

echo ""
echo "===== DONE $(date) ====="
echo "Baseline (step 0b): data/validation/condition_invariance_benchmark/result_official_embedding_slim.json"
for SEED in 1 2 3; do
    echo "  seed $SEED: data/validation/condition_invariance_benchmark/m4_v3_seed_${SEED}/result_e1_identity_epoch20.json"
done
echo ""
echo "PASS = cross_cosine rises toward pos_floor (FN gain held)"
echo "       AND negative_cosine ~0.327 NOT rising (absolute neg guard held)"
echo "       AND margin >= 0.496 (FP regression eliminated)."
echo "  (M4 v2 failed this: cross 0.873 / neg 0.424 / margin 0.449.)"
